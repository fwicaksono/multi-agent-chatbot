# Public entry point for production (docker-compose.prod.yml).
#
# SITE_ADDRESS decides the mode:
#   :80                 plain HTTP on the server's IP address
#   chat.example.com    HTTPS with an automatic Let's Encrypt certificate
#                       (the domain's DNS A record must point to this server)
#
# The application has no user accounts, so every request requires the HTTP
# basic-auth user/password from .env (BASIC_AUTH_USER / BASIC_AUTH_HASH).

{$SITE_ADDRESS::80} {
	encode gzip

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Multi-file uploads: MAX_FILES_PER_UPLOAD (20) x MAX_UPLOAD_MB (25) + headroom.
	request_body {
		max_size 520MB
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy web:80 {
		# Stream chat tokens (Server-Sent Events) without buffering.
		flush_interval -1
	}
}
