# =============================================================================
# Multi-Agent RAG Chatbot - configuration
# Copy to .env and fill in the secrets:  cp .env.example .env
# Never commit .env. All values below are safe defaults / placeholders.
# =============================================================================

# --- LLM provider credentials (set at least one) -----------------------------
OPENAI_API_KEY=
# OpenAI-compatible base URL (change only for a proxy / Azure-compatible gateway)
OPENAI_BASE_URL=https://api.openai.com/v1

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LiteLLM proxy (started by docker compose as the `litellm` service).
# Inside docker compose the API reaches it at http://litellm:4000.
LITELLM_API_BASE=http://localhost:4000
# Master key the proxy requires; any random string works for local use.
LITELLM_API_KEY=sk-litellm-change-me

# --- Defaults offered when creating a new agent -------------------------------
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4.1-mini

# --- Reliability ---------------------------------------------------------------
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Tried in order when an agent's own provider (and its optional fallback) fails.
# Format: provider:model,provider:model  (unconfigured providers are skipped over)
LLM_FALLBACK_CHAIN=openai:gpt-4.1-mini,litellm:gpt-4o-mini

# --- Embeddings (global; independent from each agent's chat provider) ---------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Changing dimensions requires a fresh database (vector column size).
EMBEDDING_DIMENSIONS=1536

# --- Retrieval -----------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MIN_SIMILARITY=0.2
# Postgres text-search config: english, simple (language-neutral), indonesian is not built in
FTS_LANGUAGE=english

# --- Chunking ------------------------------------------------------------------
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=60

# --- OCR (scanned PDFs) --------------------------------------------------------
OCR_ENABLED=true
# Tesseract language packs, e.g. eng or eng+ind
OCR_LANGUAGES=eng+ind

# --- Chat ----------------------------------------------------------------------
CHAT_HISTORY_MESSAGES=10
QUERY_REWRITE_ENABLED=true

# --- Uploads -------------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=20

# --- Database ------------------------------------------------------------------
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
# Used when running the backend outside docker; compose overrides it.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5432/chatbot

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
# json (structured, for production) or console (readable, for development)
LOG_FORMAT=json

# Optional price overrides, USD per 1M tokens:
# MODEL_PRICING_OVERRIDES={"my-model": {"input": 0.5, "output": 1.5}}

# =============================================================================
# Production only (docker-compose.prod.yml), see deploy-ec2.html
# =============================================================================
# A domain (automatic HTTPS, e.g. chat.example.com) or :80 for plain HTTP by IP
SITE_ADDRESS=:80
# The URL people type in the browser, e.g. http://203.0.113.10 or https://chat.example.com
PUBLIC_URL=http://localhost
# Login for the whole site (the app has no user accounts of its own)
BASIC_AUTH_USER=admin
# bcrypt hash of the password. Generate it with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'YOUR-PASSWORD'
# Keep the single quotes: the hash contains $ characters.
BASIC_AUTH_HASH=''
# Only with docker-compose.rds.yml (Amazon RDS):
# RDS_DATABASE_URL=postgresql+asyncpg://chatbot:PASSWORD@your-db.xxxxxxxx.ap-southeast-1.rds.amazonaws.com:5432/chatbot?ssl=require
